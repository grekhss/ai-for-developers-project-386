{
  "name": "calendar-of-meetings",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx --env-file-if-exists=.env watch server/index.ts\" \"vite\"",
    "dev:server": "tsx --env-file-if-exists=.env watch server/index.ts",
    "build": "npm run contract && tsc -b && vite build && tsc -p tsconfig.server.build.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:lsp": "oxlint --lsp",
    "contract": "bash contract/generate.sh",
    "contract:check": "bash contract/check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run contract:check && oxlint && tsc -b && tsc -p tsconfig.server.json --noEmit && vitest run",
    "start": "node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typespec/compiler": "~1.11.0",
    "@typespec/http": "~1.11.0",
    "@typespec/openapi": "~1.11.0",
    "@typespec/openapi3": "~1.11.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
