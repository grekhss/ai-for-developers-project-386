{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "calendar-of-meetings",
    "$defs": {
        "Meeting": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Meeting.json",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Идентификатор, присваиваемый базой данных."
                },
                "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "День встречи, 'YYYY-MM-DD'."
                },
                "time": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "description": "Начало встречи, 'HH:mm'."
                }
            },
            "required": [
                "id",
                "date",
                "time"
            ],
            "description": "Записи на встречи.\n\nРоль определяется по cookie `role`: `/admin` → `admin`, остальное → `guest`\n(клиент ставит её по URL; сервер не проверяет пароли и не выдает сессий).\nАдминские ручки требуют роль `admin` (иначе 403).\n\nДоменные правила букинга — окно 14 дней, прошедшие даты, выходные, сетка\nвремени — сервер проверяет (ADR-0009, server/booking-rules.ts). Формат\nпроверяется по сгенерированным схемам через `ajv` (K4); целостность —\nнесуществующий или деактивированный тип, корректное имя записавшегося из тела\n(S5/C1). Русские тексты ошибок — в `server/routes.ts`.Запись на встречу. Дата и время — строки в том формате, в котором их отдаёт\nMantine: 'YYYY-MM-DD' и 'HH:mm'."
        },
        "MeetingDraft": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "MeetingDraft.json",
            "type": "object",
            "properties": {
                "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "День встречи, 'YYYY-MM-DD'."
                },
                "time": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "description": "Начало встречи, 'HH:mm'."
                },
                "booker_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "\\S",
                    "description": "Имя записавшегося: непустая строка без пробельных только из пробелов,\nне длиннее 100 символов."
                },
                "meeting_type_id": {
                    "type": "string",
                    "description": "Тип встречи. Если поле передано — тип обязан существовать и быть активным,\nиначе 400; без поля запись создаётся «нетипизированной»."
                }
            },
            "required": [
                "date",
                "time",
                "booker_name"
            ],
            "description": "Данные новой записи — всё, кроме идентификатора.\nИмя записавшегося `booker_name` передаётся из формы (не из сессии)."
        },
        "DateRange": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "DateRange.json",
            "type": "object",
            "properties": {
                "from": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "День начала, включительно, 'YYYY-MM-DD'."
                },
                "to": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "День конца, включительно, 'YYYY-MM-DD'."
                }
            },
            "required": [
                "from",
                "to"
            ],
            "description": "Полуинтервал дат для запроса списка записей, обе границы включительно."
        },
        "MeetingType": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "MeetingType.json",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Идентификатор, присваиваемый базой данных."
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Название типа — непустая строка."
                },
                "description": {
                    "type": "string",
                    "description": "Описание типа."
                },
                "duration_minutes": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 180,
                    "description": "Длительность встречи этого типа в минутах: 30–180, кратно 30. Кратность\nтридцати проверяет роут; информационное поле: сетку слотов и занятость\nоно не меняет (ADR-0008)."
                },
                "active": {
                    "type": "boolean",
                    "description": "Активен ли тип: деактивированный нельзя выбрать при новой записи (Q7)."
                }
            },
            "required": [
                "id",
                "name",
                "description",
                "duration_minutes",
                "active"
            ],
            "description": "Тип встречи, предлагаемый администратором (Q2). Удаления нет: деактивация —\nединственный конец жизненного цикла (Q7)."
        },
        "MeetingTypeDraft": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "MeetingTypeDraft.json",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Название типа — непустая строка, минимум один непробельный символ."
                },
                "description": {
                    "type": "string",
                    "description": "Описание типа."
                },
                "duration_minutes": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 180,
                    "description": "Длительность встреч этого типа в минутах: 30–180, кратно 30."
                }
            },
            "required": [
                "name",
                "description",
                "duration_minutes"
            ],
            "description": "Данные нового типа встречи — всё, кроме идентификатора и признака активности."
        },
        "PlannedMeeting": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "PlannedMeeting.json",
            "type": "object",
            "properties": {
                "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "День встречи, 'YYYY-MM-DD'."
                },
                "time": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "description": "Начало встречи, 'HH:mm'."
                },
                "type": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Название типа встречи; null у старой записи без типа."
                },
                "booker": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Имя записавшегося; null у старой записи без booker."
                }
            },
            "required": [
                "date",
                "time",
                "type",
                "booker"
            ],
            "description": "Строка админского списка запланированных встреч: LEFT JOIN, поэтому у старых\n«нетипизированных» записей `type` и `booker` равны null (C5)."
        },
        "ErrorResponse": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ErrorResponse.json",
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            },
            "required": [
                "error"
            ],
            "description": "Форма всех ошибок API: русское описание уходит клиенту как есть."
        },
        "OkMeetingList": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "OkMeetingList.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 200
                },
                "meetings": {
                    "type": "array",
                    "items": {
                        "$ref": "Meeting.json"
                    }
                }
            },
            "required": [
                "_",
                "meetings"
            ]
        },
        "OkMeetingTypeList": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "OkMeetingTypeList.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 200
                },
                "meetingTypes": {
                    "type": "array",
                    "items": {
                        "$ref": "MeetingType.json"
                    }
                }
            },
            "required": [
                "_",
                "meetingTypes"
            ]
        },
        "OkMeetingType": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "OkMeetingType.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 200
                },
                "meetingType": {
                    "$ref": "MeetingType.json"
                }
            },
            "required": [
                "_",
                "meetingType"
            ]
        },
        "OkPlannedMeetingList": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "OkPlannedMeetingList.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 200
                },
                "meetings": {
                    "type": "array",
                    "items": {
                        "$ref": "PlannedMeeting.json"
                    }
                }
            },
            "required": [
                "_",
                "meetings"
            ],
            "description": "Все запланированные встречи для админа (S4): сегодня и будущее, без горизонта."
        },
        "CreatedMeeting": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "CreatedMeeting.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 201
                },
                "meeting": {
                    "$ref": "Meeting.json"
                }
            },
            "required": [
                "_",
                "meeting"
            ]
        },
        "CreatedMeetingType": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "CreatedMeetingType.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 201
                },
                "meetingType": {
                    "$ref": "MeetingType.json"
                }
            },
            "required": [
                "_",
                "meetingType"
            ]
        },
        "NoContent": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "NoContent.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 204
                }
            },
            "required": [
                "_"
            ]
        },
        "BadRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BadRequest.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 400
                },
                "error": {
                    "$ref": "ErrorResponse.json"
                }
            },
            "required": [
                "_",
                "error"
            ]
        },
        "Forbidden": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Forbidden.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 403
                },
                "error": {
                    "$ref": "ErrorResponse.json"
                }
            },
            "required": [
                "_",
                "error"
            ],
            "description": "Нет прав: роль не admin (ADR-0010)."
        },
        "Conflict": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Conflict.json",
            "type": "object",
            "properties": {
                "_": {
                    "type": "number",
                    "const": 409
                },
                "error": {
                    "$ref": "ErrorResponse.json"
                }
            },
            "required": [
                "_",
                "error"
            ]
        }
    }
}